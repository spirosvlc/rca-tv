[Unit]
Description=RCA Project Chromium kiosk
After=graphical.target rca.service
Wants=rca.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
ExecStart=/usr/bin/chromium --kiosk --autoplay-policy=no-user-gesture-required --disable-session-crashed-bubble --disable-infobars http://127.0.0.1:8080/
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
